{
  "$description": "Folio DS theme-independent tokens: typography, spacing, motion, radius, z-index.",
  "font": {
    "family-sans": { "$type": "fontFamily", "$value": ["Inter", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"], "$description": "Primary typeface" },
    "family-mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "monospace"], "$description": "Technical labels, data, numerals" }
  },
  "text": {
    "hero": { "$type": "dimension", "$value": "clamp(2.2rem, 5vw, 3.8rem)", "$description": "Hero display size" },
    "title": { "$type": "dimension", "$value": "clamp(2rem, 4vw, 3rem)", "$description": "Page / section title size" },
    "subtitle": { "$type": "dimension", "$value": "1.125rem", "$description": "Lead paragraph size" },
    "body": { "$type": "dimension", "$value": "0.95rem", "$description": "Body copy size" },
    "small": { "$type": "dimension", "$value": "0.875rem", "$description": "UI text size (nav, buttons)" },
    "caption": { "$type": "dimension", "$value": "0.8125rem", "$description": "Captions, secondary UI" },
    "label": { "$type": "dimension", "$value": "0.6875rem", "$description": "Mono uppercase labels, tags" },
    "micro": { "$type": "dimension", "$value": "0.62rem", "$description": "Smallest technical annotations" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem", "$description": "4px" },
    "2": { "$type": "dimension", "$value": "0.5rem", "$description": "8px" },
    "3": { "$type": "dimension", "$value": "0.75rem", "$description": "12px" },
    "4": { "$type": "dimension", "$value": "1rem", "$description": "16px" },
    "5": { "$type": "dimension", "$value": "1.5rem", "$description": "24px" },
    "6": { "$type": "dimension", "$value": "2rem", "$description": "32px" },
    "7": { "$type": "dimension", "$value": "2.5rem", "$description": "40px" },
    "8": { "$type": "dimension", "$value": "3rem", "$description": "48px" },
    "9": { "$type": "dimension", "$value": "4rem", "$description": "64px" },
    "10": { "$type": "dimension", "$value": "6rem", "$description": "96px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0", "$description": "The system's only radius — sharp corners are part of the identity" }
  },
  "motion": {
    "ease-out-expo": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1], "$description": "Primary easing" },
    "ease-reveal": { "$type": "cubicBezier", "$value": [0.01, 0.73, 0.42, 0.99], "$description": "Entrance/reveal easing" },
    "duration-fast": { "$type": "duration", "$value": "250ms", "$description": "Hover, small state changes" },
    "duration-base": { "$type": "duration", "$value": "400ms", "$description": "Transitions, reveals" },
    "duration-slow": { "$type": "duration", "$value": "600ms", "$description": "Page-level transitions" }
  },
  "z": {
    "base": { "$type": "number", "$value": 0 },
    "content": { "$type": "number", "$value": 1 },
    "toast": { "$type": "number", "$value": 100 },
    "nav": { "$type": "number", "$value": 500 },
    "tooltip": { "$type": "number", "$value": 600 },
    "overlay": { "$type": "number", "$value": 700 }
  },
  "breakpoint": {
    "mobile": { "$type": "dimension", "$value": "768px", "$description": "Primary breakpoint" }
  }
}
