{
  "$description": "Folio DS color tokens — dark theme (default). Reconciled 2026-09-10 against the live portfolio :root.",
  "color": {
    "bg": { "$type": "color", "$value": "#1b1c1e", "$description": "Page background" },
    "bg-elevated": { "$type": "color", "$value": "#232427", "$description": "Elevated surfaces (hover states, raised panels)" },
    "bg-card": { "$type": "color", "$value": "#26282b", "$description": "Card background" },
    "text": { "$type": "color", "$value": "#e7e3d7", "$description": "Primary text" },
    "text-muted": { "$type": "color", "$value": "rgba(231, 227, 215, 0.5)", "$description": "Secondary text" },
    "text-dim": { "$type": "color", "$value": "rgba(231, 227, 215, 0.24)", "$description": "Tertiary / disabled text" },
    "border": { "$type": "color", "$value": "rgba(231, 227, 215, 0.12)", "$description": "Default border" },
    "border-hover": { "$type": "color", "$value": "rgba(231, 227, 215, 0.26)", "$description": "Border on hover / emphasis" },
    "accent": { "$type": "color", "$value": "#8ba6c6", "$description": "Accent (interactive emphasis)" },
    "accent-strong": { "$type": "color", "$value": "#a7bdd6", "$description": "Accent, stronger (hover)" },
    "accent-soft": { "$type": "color", "$value": "rgba(139, 166, 198, 0.14)", "$description": "Accent tint (backgrounds)" },
    "surface": { "$type": "color", "$value": "rgba(30, 31, 34, 0.72)", "$description": "Translucent surface (overlays)" },
    "surface-light": { "$type": "color", "$value": "rgba(30, 31, 34, 0.6)", "$description": "Lighter translucent surface" },
    "surface-border": { "$type": "color", "$value": "rgba(231, 227, 215, 0.08)", "$description": "Border on translucent surfaces" },
    "ink": { "$type": "color", "$value": "rgba(231, 227, 215, 0.1)", "$description": "Faint ink (decorative text, separators)" },
    "ink-strong": { "$type": "color", "$value": "rgba(231, 227, 215, 0.28)", "$description": "Stronger faint ink" },
    "status-ok": { "$type": "color", "$value": "#4caf6e", "$description": "Positive / success" },
    "status-ok-soft": { "$type": "color", "$value": "rgba(76, 175, 110, 0.14)", "$description": "Positive tint background" },
    "status-warn": { "$type": "color", "$value": "#e8a020", "$description": "Warning / caution" },
    "status-warn-soft": { "$type": "color", "$value": "rgba(232, 160, 32, 0.14)", "$description": "Warning tint background" },
    "status-danger": { "$type": "color", "$value": "#e85050", "$description": "Critical / error" },
    "status-danger-soft": { "$type": "color", "$value": "rgba(232, 80, 80, 0.14)", "$description": "Critical tint background" },
    "status-info": { "$type": "color", "$value": "#8888ff", "$description": "Informational / neutral highlight" },
    "status-info-soft": { "$type": "color", "$value": "rgba(136, 136, 255, 0.14)", "$description": "Informational tint background" },
    "cta": { "$type": "color", "$value": "#3566b3", "$description": "Primary CTA fill. Deliberately NOT theme-swapped — the same blue reads in dark and light so the CTA stays recognisable. Bright enough to register as blue, dark enough to hold white label text at ~5.5:1." },
    "cta-hot": { "$type": "color", "$value": "#4478c4", "$description": "Primary CTA fill on hover" },
    "cta-ink": { "$type": "color", "$value": "#ffffff", "$description": "Label colour on a CTA fill" },
    "key": { "$type": "color", "$value": "#e0ac4e", "$description": "Key-project gold. Warm end of the process stream (the \"Ship\" pixels) and the KEY badge, so it cuts through the blue." },
    "key-hot": { "$type": "color", "$value": "#eec26d", "$description": "Key gold on hover" },
    "key-ink": { "$type": "color", "$value": "#e0ac4e", "$description": "Key gold as text. Darkened in the light theme to stay legible." },
    "glow": { "$type": "color", "$value": "transparent", "$description": "Row hover wash. Transparent in both themes today — kept as a token so the effect can be reintroduced from one place." }
  }
}
